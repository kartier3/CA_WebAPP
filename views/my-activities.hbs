{{> menu}}

<div class="ui container">
  <div class="ui basic segment">
    <div class="ui two column middle aligned grid">
      <div class="column">
        <h1 class="ui header">
          <i class="tasks icon"></i>
          <div class="content">
            My Activities
            <div class="sub header">Manage your personal activity collection</div>
          </div>
        </h1>
      </div>
      <div class="right aligned column">
        <a href="/activity/add" class="ui primary button">
          <i class="plus icon"></i> Add Activity
        </a>
      </div>
    </div>
  </div>

  <!-- search and sort Controls for user  -->
  <div class="ui segment">
    <form action="/my-activities" method="GET" class="ui form">
      <div class="ui two column stackable grid">
        <div class="column">
          <div class="field">
            <label>Search My Activities</label>
            <div class="ui icon input">
              <input type="text" name="search" placeholder="Search by name, description, or difficulty..." value="{{searchQuery}}">
              <i class="search icon"></i>
            </div>
          </div>
        </div>
        <div class="column">
          <div class="field">
            <label>Sort By</label>
            <select name="sort" class="ui dropdown">
              <option value="name" {{#if (eq sortBy 'name')}}selected{{/if}}>Name (A-Z)</option>
              <option value="difficulty" {{#if (eq sortBy 'difficulty')}}selected{{/if}}>Difficulty (Easy to Hard)</option>
            </select>
          </div>
        </div>
      </div>
      <button type="submit" class="ui primary button">
        <i class="filter icon"></i> Apply Filters
      </button>
      <a href="/my-activities" class="ui button">Clear Filters</a>
    </form>
  </div>

  <!-- Individual user statistics -->
  <div class="ui segment">
    <h3 class="ui header">
      <i class="user circle icon"></i>
      <div class="content">
        My Statistics
        <div class="sub header">Overview of your activity collection</div>
      </div>
    </h3>
    <div class="ui four column stackable grid">
      <div class="column">
        <div class="ui statistic">
          <div class="value">
            <i class="tasks icon"></i> {{userStats.totalActivities}}
          </div>
          <div class="label">
            Total Activities
          </div>
        </div>
      </div>
      <div class="column">
        <div class="ui statistic">
          <div class="value green">
            <i class="smile icon"></i> {{userStats.easyCount}}
          </div>
          <div class="label">
            Easy
          </div>
        </div>
      </div>
      <div class="column">
        <div class="ui statistic">
          <div class="value orange">
            <i class="meh icon"></i> {{userStats.mediumCount}}
          </div>
          <div class="label">
            Medium
          </div>
        </div>
      </div>
      <div class="column">
        <div class="ui statistic">
          <div class="value red">
            <i class="frown icon"></i> {{userStats.hardCount}}
          </div>
          <div class="label">
            Hard
          </div>
        </div>
      </div>
    </div>
  </div>

  {{#unless activities.length}}
    <div class="ui info message">
      <div class="header">No Activities Yet</div>
      <p>You haven't added any activities to your collection. Click the "Add Activity" button to get started!</p>
    </div>
  {{/unless}}

  <div class="ui three column stackable grid">
    {{#each activities}}
      <div class="column">
        <div class="ui card">
          <div class="image">
            <img src="{{image}}" alt="{{name}}" style="height: 200px; object-fit: cover;">
          </div>
          <div class="content">
            <div class="header">{{name}}</div>
            <div class="meta">{{description}}</div>
            <div class="description">
              <span class="ui {{#if (eq difficulty "Easy")}}green{{else if (eq difficulty "Medium")}}yellow{{else}}red{{/if}} label">
                {{difficulty}}
              </span>
            </div>
          </div>
          <div class="extra content">
            <div class="ui two buttons">
              <a href="/activity/edit/{{id}}" class="ui basic blue button">
                <i class="edit icon"></i> Edit
              </a>
              <form action="/activity/delete/{{id}}" method="POST" style="display: inline; width: 50%;">
                <button type="submit" class="ui basic red button" style="width: 100%;" onclick="return confirm('Are you sure you want to delete this activity?');">
                  <i class="trash icon"></i> Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>
