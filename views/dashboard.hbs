{{> menu}}
<div class="ui container">
  <h1 class="ui header">
    <i class="compass icon"></i>
    <div class="content">
      Activity Dashboard
      <div class="sub header">Explore all available adventure activities</div>
    </div>
  </h1>

  <!-- NEW CODE: Search and Sort Controls for Global Activities -->
  <div class="ui segment">
    <form action="/dashboard" method="GET" class="ui form">
      <div class="ui two column stackable grid">
        <div class="column">
          <div class="field">
            <label>Search Activities</label>
            <div class="ui icon input">
              <input type="text" name="search" placeholder="Search by name, description, or difficulty..." value="{{searchQuery}}">
              <i class="search icon"></i>
            </div>
          </div>
        </div>
        <div class="column">
          <div class="field">
            <label>Sort By</label>
            <select name="sort" class="ui dropdown">
              <option value="name" {{#if (eq sortBy 'name')}}selected{{/if}}>Name (A-Z)</option>
              <option value="difficulty" {{#if (eq sortBy 'difficulty')}}selected{{/if}}>Difficulty (Easy to Hard)</option>
            </select>
          </div>
        </div>
      </div>
      <button type="submit" class="ui primary button">
        <i class="filter icon"></i> Apply Filters
      </button>
      <a href="/dashboard" class="ui button">Clear Filters</a>
    </form>
  </div>

  {{#if userActivities.length}}
    <div class="ui segment">
      <h2 class="ui header">
        <i class="user icon"></i>
        <div class="content">
          My Activities
          <div class="sub header">Your personal activity collection</div>
        </div>
      </h2>
      <div class="ui three stackable cards">
        {{#each userActivities}}
          <div class="card">
            <div class="image">
              <img src="{{this.image}}" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
            </div>
            <div class="content">
              <div class="header">{{this.name}}</div>
              <div class="meta">
                <span>Difficulty: {{this.difficulty}}</span>
              </div>
              <div class="description">
                <p>{{this.description}}</p>
              </div>
            </div>
            <div class="extra content">
              {{#if (eq this.difficulty "Easy")}}
                <i class="green smile outline icon"></i> Easy
              {{else if (eq this.difficulty "Medium")}}
                <i class="orange meh outline icon"></i> Medium
              {{else}}
                <i class="red frown outline icon"></i> Hard
              {{/if}}
              
              <a href="/my-activities" class="right floated" title="Manage in My Activities">
                <i class="large edit link icon"></i>
              </a>
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <h2 class="ui header">
    <i class="globe icon"></i>
    <div class="content">
      Global Activities
      <div class="sub header">Explore activities available to everyone</div>
    </div>
  </h2>

  <div class="ui three stackable cards">
    {{#each activities}}
      <div class="card">
        <div class="image">
          <img src="{{this.image}}" alt="{{this.name}}" style="height: 200px; object-fit: cover;">
        </div>
        <div class="content">
          <div class="header">{{this.name}}</div>
          <div class="meta">
            <span>Difficulty: {{this.difficulty}}</span>
          </div>
          <div class="description">
            <p>{{this.description}}</p>
          </div>
        </div>
        <div class="extra content">
          {{#if (eq this.difficulty "Easy")}}
            <i class="green smile outline icon"></i> Easy
          {{else if (eq this.difficulty "Medium")}}
            <i class="orange meh outline icon"></i> Medium
          {{else}}
            <i class="red frown outline icon"></i> Hard
          {{/if}}
          
          <a href="/activity/{{this.id}}" class="right floated" title="View Details">
            <i class="large eye link icon"></i>
          </a>
          


          {{#if user}}
            <form action="/activity/add-global/{{this.id}}" method="POST" style="display: inline;">
              <button type="submit" class="ui basic green button" style="margin-left: 10px;" title="Add to My Activities">
                <i class="plus icon"></i> Add
              </button>
            </form>
          {{/if}}
        </div>
      </div>
    {{/each}}
  </div>
</div>